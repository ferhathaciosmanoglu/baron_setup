{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BARON",
  "version": "1.2.1",
  "identifier": "com.baron.scheduler",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BARON Ders Programı",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "BARON",
        "url": "splash.html",
        "width": 520,
        "height": 390,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "BARON",
    "category": "Productivity",
    "shortDescription": "BARON Ders Programı Yönetim Sistemi",
    "longDescription": "Firebase bağlantılı BARON haftalık ders dağıtım ve okul program yönetim sistemi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "tr-TR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4N0FFRkY2RjdFMkRCODAKUldTQTIrTDM5dTk2NlAyUzRzS0dMUkFGdVVuT2hxbWVxOHhvMmZGNFVIemE1WWhhVmxEN3ZBTEkK",
      "endpoints": [
        "https://github.com/F6RH1T/baron_setup/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
